          </Variable>
          <Variable name="bStop">
            <AddData>
              <Data name="http://www.mitsubishielectric.com/xml/VariableComments" handleUnknown="implementation">
                <VariableComments>
                  <Comment number="6"><CommentText>停止按钮</CommentText></Comment>
                </VariableComments>
              </Data>
            </AddData>
            <Type>
              <TypeName>BOOL</TypeName>
            </Type>
