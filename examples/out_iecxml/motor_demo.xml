                  <Comment number="6"><CommentText>故障标志</CommentText></Comment>
                </VariableComments>
              </Data>
            </AddData>
            <Type>
              <TypeName>BOOL</TypeName>
            </Type>
            <InitialValue>
              <SimpleValue value="FALSE"/>
            </InitialValue>
          </Variable>
          <Variable name="bAutoStop">
            <AddData>
              <Data name="http://www.mitsubishielectric.com/xml/VariableComments" handleUnknown="implementation">
                <VariableComments>
                  <Comment number="6"><CommentText>自动停止</CommentText></Comment>
                </VariableComments>
              </Data>
            </AddData>
            <Type>
              <TypeName>BOOL</TypeName>
            </Type>
            <InitialValue>
              <SimpleValue value="FALSE"/>
            </InitialValue>
          </Variable>
          <Variable name="tRunTimer">
            <AddData>
              <Data name="http://www.mitsubishielectric.com/xml/VariableComments" handleUnknown="implementation">
                <VariableComments>
                  <Comment number="6"><CommentText>运行定时器</CommentText></Comment>
                </VariableComments>
              </Data>
            </AddData>
            <Type>
              <TypeName>TON</TypeName>
            </Type>
          </Variable>
          <Variable name="stMotor">
            <AddData>
              <Data name="http://www.mitsubishielectric.com/xml/VariableComments" handleUnknown="implementation">
                <VariableComments>
                  <Comment number="6"><CommentText>电机状态</CommentText></Comment>
                </VariableComments>
              </Data>
            </AddData>
            <Type>
              <TypeName>ST_Motor</TypeName>
            </Type>
          </Variable>
          <Variable name="nStep">
            <AddData>
              <Data name="http://www.mitsubishielectric.com/xml/VariableComments" handleUnknown="implementation">
                <VariableComments>
                  <Comment number="6"><CommentText>状态机步进</CommentText></Comment>
                </VariableComments>
              </Data>
            </AddData>
            <Type>
              <TypeName>INT</TypeName>
            </Type>
            <InitialValue>
              <SimpleValue value="0"/>
            </InitialValue>
          </Variable>
        </Vars>
        <MainBody>
          <BodyContent xsi:type="ST">
            <ST>    (* 故障优先处理：任何故障都立即停机 *)
    IF bFault THEN
        Y0 := FALSE;
        nStep := 0;
        RETURN;
    END_IF;

    CASE nStep OF
        0: (* 待机 *)
            IF bStart THEN
                nStep := 1;
            END_IF;

        1: (* 运行 *)
            tRunTimer(IN := TRUE, PT := T#10s);
            IF tRunTimer.Q OR bStop THEN
                nStep := 2;
            END_IF;

        2: (* 停机 *)
            tRunTimer(IN := FALSE, PT := T#10s);
            nStep := 0;
    END_CASE;

    (* 输出驱动 *)
    CASE nStep OF
        1: Y0 := TRUE;
        ELSE Y0 := FALSE;
    END_CASE;</ST>
          </BodyContent>
        </MainBody>
      </Program>
