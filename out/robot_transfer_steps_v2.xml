        <MainBody>
          <BodyContent xsi:type="ST">
            <ST>    // ---- 1) HMI 命令上升沿 ----
    b启动上升沿 := 触摸屏启动 AND NOT b启动上次;
    b启动上次 := 触摸屏启动;
    b停止上升沿 := 触摸屏停止 AND NOT b停止上次;
    b停止上次 := 触摸屏停止;
    b复位上升沿 := 触摸屏复位 AND NOT b复位上次;
    b复位上次 := 触摸屏复位;
    b手动上升沿 := 触摸屏手动 AND NOT b手动上次;
    b手动上次 := 触摸屏手动;
    b退出手动上升沿 := 触摸屏退出手动 AND NOT b退出手动上次;
    b退出手动上次 := 触摸屏退出手动;
    b继续上升沿 := 触摸屏继续 AND NOT b继续上次;
    b继续上次 := 触摸屏继续;
    b从头上升沿 := 触摸屏从头 AND NOT b从头上次;
    b从头上次 := 触摸屏从头;
    b手动竖直缸上升沿 := 手动竖直缸 AND NOT b手动竖直缸上次;
    b手动竖直缸上次 := 手动竖直缸;
    b手动水平缸上升沿 := 手动水平缸 AND NOT b手动水平缸上次;
    b手动水平缸上次 := 手动水平缸;
    b手动夹爪上升沿 := 手动夹爪 AND NOT b手动夹爪上次;
    b手动夹爪上次 := 手动夹爪;

    // ---- 2) 急停：任何模式立即暂停，冻结步号 ----
    IF 急停 THEN
        IF n模式 &lt;&gt; 5 THEN
            n模式 := 5;
            b急停暂停 := TRUE;
        END_IF;
    END_IF;

    // ---- 3) 模式与 HMI 命令 ----
    b气缸位置正常 := ((竖直缸下降到位) OR (竖直缸上升到位)) AND ((水平右限位) OR (水平左限位)) AND ((夹爪夹紧到位) OR (夹爪松开到位));

    // 待机：启动/切手动
    IF n模式 = 0 THEN
        IF b启动上升沿 THEN
            n步号 := 1;
            n模式 := 1;
            b停止请求 := FALSE;
            b停止序列启动 := FALSE;
            b报警 := FALSE;
            b急停暂停 := FALSE;
            n报警码 := 0;
            n报警步号 := 0;
        END_IF;
        IF b手动上升沿 AND NOT 急停 THEN
            n模式 := 2;
            b竖直缸伸出命令 := FALSE;
            b竖直缸缩回命令 := FALSE;
            b水平缸伸出命令 := FALSE;
            b水平缸缩回命令 := FALSE;
            b夹爪夹紧命令 := (夹爪夹紧到位);  // 保持当前夹紧状态
        END_IF;
    END_IF;

    // 自动：停止请求（当前步完成后进入停止序列）
    IF n模式 = 1 THEN
        IF b停止上升沿 THEN
            b停止请求 := TRUE;
        END_IF;
    END_IF;

    // 报警/急停暂停：切手动处理、停止、从头开始
    IF (n模式 = 4) OR (n模式 = 5) THEN
        IF b手动上升沿 AND NOT 急停 THEN
            n模式 := 2;
            b竖直缸伸出命令 := FALSE;
            b竖直缸缩回命令 := FALSE;
            b水平缸伸出命令 := FALSE;
            b水平缸缩回命令 := FALSE;
            b夹爪夹紧命令 := (夹爪夹紧到位);  // 保持当前夹紧状态
        END_IF;
        IF b停止上升沿 THEN
            n模式 := 3;
            IF NOT b停止序列启动 THEN
                n停止步号 := 1;
                b停止序列启动 := TRUE;
            END_IF;
        END_IF;
        IF b从头上升沿 THEN
            n模式 := 0;
            n步号 := 0;
            n停止步号 := 0;
            b停止序列启动 := FALSE;
            b停止请求 := FALSE;
            b报警 := FALSE;
            b急停暂停 := FALSE;
            n报警码 := 0;
            n报警步号 := 0;
            b竖直缸伸出命令 := FALSE;
            b竖直缸缩回命令 := FALSE;
            b水平缸伸出命令 := FALSE;
            b水平缸缩回命令 := FALSE;
            b夹爪夹紧命令 := FALSE;
        END_IF;
    END_IF;

    // 手动：清故障、退出手动、继续/停止/从头
    IF n模式 = 2 THEN
        IF b复位上升沿 AND b气缸位置正常 AND NOT 急停 THEN
            b报警 := FALSE;
            b急停暂停 := FALSE;
            n报警码 := 0;
            n报警步号 := 0;
        END_IF;
        IF b退出手动上升沿 AND b气缸位置正常 AND NOT b报警 AND NOT b急停暂停 AND NOT 急停 THEN
            n模式 := 0;
            n步号 := 0;
            b停止序列启动 := FALSE;
        END_IF;
        IF b继续上升沿 AND b气缸位置正常 AND NOT b报警 AND NOT b急停暂停 AND NOT 急停 THEN
            IF b停止序列启动 THEN
                n模式 := 3;
            ELSE
                n模式 := 1;
            END_IF;
            b停止请求 := FALSE;
        END_IF;
        IF b停止上升沿 THEN
            n模式 := 3;
            IF NOT b停止序列启动 THEN
                n停止步号 := 1;
                b停止序列启动 := TRUE;
            END_IF;
        END_IF;
        IF b从头上升沿 THEN
            n模式 := 0;
            n步号 := 0;
            n停止步号 := 0;
            b停止序列启动 := FALSE;
            b停止请求 := FALSE;
            b报警 := FALSE;
            b急停暂停 := FALSE;
            n报警码 := 0;
            n报警步号 := 0;
            b竖直缸伸出命令 := FALSE;
            b竖直缸缩回命令 := FALSE;
            b水平缸伸出命令 := FALSE;
            b水平缸缩回命令 := FALSE;
            b夹爪夹紧命令 := FALSE;
        END_IF;
    END_IF;

    // 急停仍按住时禁止任何模式切换
    IF 急停 THEN
        n模式 := 5;
    END_IF;

    // ---- 4) 手动翻转（仅手动模式） ----
        IF n模式 = 2 THEN
            // 手动翻转：竖直缸（手动竖直缸）
            IF b手动竖直缸上升沿 THEN
                IF 竖直缸上升到位 THEN
                    b竖直缸伸出命令 := TRUE;
                    b竖直缸缩回命令 := FALSE;
                ELSIF 竖直缸下降到位 THEN
                    b竖直缸伸出命令 := FALSE;
                    b竖直缸缩回命令 := TRUE;
                ELSE
                    // 位置未知（卡在中间）：默认缩回原位，便于人工恢复
                    b竖直缸伸出命令 := FALSE;
                    b竖直缸缩回命令 := TRUE;
                END_IF;
            END_IF;
            IF b竖直缸伸出命令 AND 竖直缸下降到位 THEN
                b竖直缸伸出命令 := FALSE;
            END_IF;
            IF b竖直缸缩回命令 AND 竖直缸上升到位 THEN
                b竖直缸缩回命令 := FALSE;
            END_IF;

            // 手动翻转：水平缸（手动水平缸）
            IF b手动水平缸上升沿 THEN
                IF 水平左限位 THEN
                    b水平缸伸出命令 := TRUE;
                    b水平缸缩回命令 := FALSE;
                ELSIF 水平右限位 THEN
                    b水平缸伸出命令 := FALSE;
                    b水平缸缩回命令 := TRUE;
                ELSE
                    // 位置未知（卡在中间）：默认缩回原位，便于人工恢复
                    b水平缸伸出命令 := FALSE;
                    b水平缸缩回命令 := TRUE;
                END_IF;
            END_IF;
            IF b水平缸伸出命令 AND 水平右限位 THEN
                b水平缸伸出命令 := FALSE;
            END_IF;
            IF b水平缸缩回命令 AND 水平左限位 THEN
                b水平缸缩回命令 := FALSE;
            END_IF;

            // 手动翻转：夹爪（手动夹爪）
            IF b手动夹爪上升沿 THEN
                IF 夹爪松开到位 THEN
                    b夹爪夹紧命令 := TRUE;
                ELSIF 夹爪夹紧到位 THEN
                    b夹爪夹紧命令 := FALSE;
                ELSE
                    // 位置未知（卡在中间）：默认松开回原位，便于人工恢复
                    b夹爪夹紧命令 := FALSE;
                END_IF;
            END_IF;

        END_IF;

    // ---- 5) 气缸命令（按模式；双电控默认保持，单电控默认松开） ----
    IF n模式 &lt;&gt; 2 THEN
    b竖直缸伸出命令 := FALSE;
    b竖直缸缩回命令 := FALSE;
    b水平缸伸出命令 := FALSE;
    b水平缸缩回命令 := FALSE;
    b夹爪夹紧命令 := FALSE;
    END_IF;

    IF n模式 = 1 THEN
        CASE n步号 OF
            // S1 竖直下降
            1:
        b竖直缸伸出命令 := TRUE;
            // S2 夹爪夹紧
            2:
        b竖直缸伸出命令 := TRUE;
        b夹爪夹紧命令 := TRUE;
            // S3 竖直上升
            3:
        b竖直缸缩回命令 := TRUE;
        b夹爪夹紧命令 := TRUE;
            // S4 水平右移
            4:
        b夹爪夹紧命令 := TRUE;
        b水平缸伸出命令 := TRUE;
            // S5 右位竖直下降
            5:
        b竖直缸伸出命令 := TRUE;
        b夹爪夹紧命令 := TRUE;
        b水平缸伸出命令 := TRUE;
            // S6 夹爪松开
            6:
        b竖直缸伸出命令 := TRUE;
        b夹爪夹紧命令 := FALSE;
        b水平缸伸出命令 := TRUE;
            // S7 松开后上升
            7:
        b竖直缸缩回命令 := TRUE;
        b水平缸伸出命令 := TRUE;
            // S8 水平左移回原位
            8:
        b水平缸缩回命令 := TRUE;
        END_CASE;
    ELSIF n模式 = 3 THEN
        CASE n停止步号 OF
            // T1 竖直上升回原位
            1:
        b竖直缸伸出命令 := TRUE;
        b竖直缸缩回命令 := TRUE;
        b夹爪夹紧命令 := TRUE;
            // T2 水平左移回原位
            2:
        b水平缸伸出命令 := TRUE;
        b水平缸缩回命令 := TRUE;
        b夹爪夹紧命令 := TRUE;
            // T3 夹爪松开
            3:
        b夹爪夹紧命令 := FALSE;
            // T4 全部输出关闭
            4:
        b竖直缸伸出命令 := TRUE;
        b竖直缸缩回命令 := TRUE;
        b夹爪夹紧命令 := FALSE;
        b水平缸伸出命令 := TRUE;
        b水平缸缩回命令 := TRUE;
        END_CASE;
    END_IF;

    // ---- 6) 气缸 FB 调用（输出 + 5s 超时监视） ----
    // 竖直缸（双电控）
    fb竖直缸(b使能 := (n模式 = 1) OR (n模式 = 2) OR (n模式 = 3),
              b伸出命令 := b竖直缸伸出命令, b缩回命令 := b竖直缸缩回命令,
              x伸出到位 := 竖直缸下降到位, x原位到位 := 竖直缸上升到位,
              t超时 := T#5000ms,
              n伸出报警码 := 10, n缩回报警码 := 11,
              b伸出输出 =&gt; b竖直缸伸出输出, b缩回输出 =&gt; b竖直缸缩回输出,
              b报警 =&gt; b竖直缸报警, n报警码 =&gt; n竖直缸报警码);

    // 水平缸（双电控）
    fb水平缸(b使能 := (n模式 = 1) OR (n模式 = 2) OR (n模式 = 3),
              b伸出命令 := b水平缸伸出命令, b缩回命令 := b水平缸缩回命令,
              x伸出到位 := 水平右限位, x原位到位 := 水平左限位,
              t超时 := T#5000ms,
              n伸出报警码 := 20, n缩回报警码 := 21,
              b伸出输出 =&gt; b水平缸伸出输出, b缩回输出 =&gt; b水平缸缩回输出,
              b报警 =&gt; b水平缸报警, n报警码 =&gt; n水平缸报警码);

    // 夹爪（单电控）
    fb夹爪(b使能 := (n模式 = 1) OR (n模式 = 2) OR (n模式 = 3),
              b夹紧命令 := b夹爪夹紧命令,
              x夹紧到位 := 夹爪夹紧到位, x松开到位 := 夹爪松开到位,
              t超时 := T#5000ms,
              n夹紧报警码 := 30, n松开报警码 := 31,
              b夹紧输出 =&gt; b夹爪夹紧输出, b报警 =&gt; b夹爪报警, n报警码 =&gt; n夹爪报警码);


    // ---- 7) 报警汇总（任一气缸超时 → 冻结步号、等手动处理） ----
    b存在报警 := b竖直缸报警 OR b水平缸报警 OR b夹爪报警;
    IF b存在报警 AND NOT b报警 THEN
        b报警 := TRUE;
        n模式 := 4;
        n报警步号 := n步号;
        IF b竖直缸报警 THEN n报警码 := n竖直缸报警码;  // 竖直缸
        ELSIF b水平缸报警 THEN n报警码 := n水平缸报警码;  // 水平缸
        ELSIF b夹爪报警 THEN n报警码 := n夹爪报警码;  // 夹爪
        END_IF;
    b竖直缸伸出命令 := FALSE;
    b竖直缸缩回命令 := FALSE;
    b水平缸伸出命令 := FALSE;
    b水平缸缩回命令 := FALSE;
    b夹爪夹紧命令 := FALSE;
    END_IF;

    // ---- 8) 自动步转移（报警/急停时 n模式 不是自动，流程不跳转） ----
        IF n模式 = 1 THEN
            CASE n步号 OF
                // S1 竖直下降
                1:
                    IF (竖直缸下降到位) THEN
                        IF b停止请求 THEN
                            n模式 := 3;
                            n停止步号 := 1;
                            b停止序列启动 := TRUE;
                            b停止请求 := FALSE;
                        ELSE
                            n步号 := 2;
                        END_IF;
                    END_IF;
                // S2 夹爪夹紧
                2:
                    IF (夹爪夹紧到位) THEN
                        IF b停止请求 THEN
                            n模式 := 3;
                            n停止步号 := 1;
                            b停止序列启动 := TRUE;
                            b停止请求 := FALSE;
                        ELSE
                            n步号 := 3;
                        END_IF;
                    END_IF;
                // S3 竖直上升
                3:
                    IF (竖直缸上升到位) THEN
                        IF b停止请求 THEN
                            n模式 := 3;
                            n停止步号 := 1;
                            b停止序列启动 := TRUE;
                            b停止请求 := FALSE;
                        ELSE
                            n步号 := 4;
                        END_IF;
                    END_IF;
                // S4 水平右移
                4:
                    IF (水平右限位) THEN
                        IF b停止请求 THEN
                            n模式 := 3;
                            n停止步号 := 1;
                            b停止序列启动 := TRUE;
                            b停止请求 := FALSE;
                        ELSE
                            n步号 := 5;
                        END_IF;
                    END_IF;
                // S5 右位竖直下降
                5:
                    IF (竖直缸下降到位) THEN
                        IF b停止请求 THEN
                            n模式 := 3;
                            n停止步号 := 1;
                            b停止序列启动 := TRUE;
                            b停止请求 := FALSE;
                        ELSE
                            n步号 := 6;
                        END_IF;
                    END_IF;
                // S6 夹爪松开
                6:
                    IF (夹爪松开到位) THEN
                        IF b停止请求 THEN
                            n模式 := 3;
                            n停止步号 := 1;
                            b停止序列启动 := TRUE;
                            b停止请求 := FALSE;
                        ELSE
                            n步号 := 7;
                        END_IF;
                    END_IF;
                // S7 松开后上升
                7:
                    IF (竖直缸上升到位) THEN
                        IF b停止请求 THEN
                            n模式 := 3;
                            n停止步号 := 1;
                            b停止序列启动 := TRUE;
                            b停止请求 := FALSE;
                        ELSE
                            n步号 := 8;
                        END_IF;
                    END_IF;
                // S8 水平左移回原位
                8:
                    IF (水平左限位) THEN
                        IF b停止请求 THEN
                            n模式 := 3;
                            n停止步号 := 1;
                            b停止序列启动 := TRUE;
                            b停止请求 := FALSE;
                        ELSE
                            n步号 := 0;
                            n模式 := 0;
                        END_IF;
                    END_IF;
            END_CASE;
        END_IF;

    // ---- 9) 停止序列（按顺序回原点，不直接清输出） ----
        IF n模式 = 3 THEN
            CASE n停止步号 OF
                // T1 竖直上升回原位
                1:
                    IF (竖直缸上升到位) THEN
                        n停止步号 := 2;
                    END_IF;
                // T2 水平左移回原位
                2:
                    IF (水平左限位) THEN
                        n停止步号 := 3;
                    END_IF;
                // T3 夹爪松开
                3:
                    IF (夹爪松开到位) THEN
                        n停止步号 := 4;
                    END_IF;
                // T4 全部输出关闭
                4:
                    IF (TRUE) THEN
                        n停止步号 := 5;
                    END_IF;
                ELSE
                    n模式 := 0;
                    n步号 := 0;
                    n停止步号 := 0;
                    b停止序列启动 := FALSE;
                    b停止请求 := FALSE;
            END_CASE;
        END_IF;

    // ---- 输出汇总（Y 只在此处驱动；待机全关，其他模式取 FB 输出） ----
    IF n模式 = 0 THEN
        竖直下降电磁阀 := FALSE;
        竖直上升电磁阀 := FALSE;
        水平右移电磁阀 := FALSE;
        水平左移电磁阀 := FALSE;
        夹爪电磁阀 := FALSE;
    ELSE
        竖直下降电磁阀 := b竖直缸伸出输出;
        竖直上升电磁阀 := b竖直缸缩回输出;
        水平右移电磁阀 := b水平缸伸出输出;
        水平左移电磁阀 := b水平缸缩回输出;
        夹爪电磁阀 := b夹爪夹紧输出;
    END_IF;

    // ---- 11) HMI 状态/数据 ----
    状态待机 := (n模式 = 0);
    状态自动 := (n模式 = 1);
    状态手动 := (n模式 = 2);
    状态停止中 := (n模式 = 3);
    状态报警 := b报警;
    状态急停暂停 := b急停暂停;
    当前步号 := n步号;
    当前模式 := n模式;
    报警代码 := n报警码;
    报警步号 := n报警步号;</ST>
          </BodyContent>
        </MainBody>
      </Program>
        <FunctionBlock name="FB_Cylinder">
          <Parameters>
            <InputVars>
              <Variable name="b使能" orderWithinParamSet="1">
                <Type>
                  <TypeName>BOOL</TypeName>
                </Type>
              </Variable>
              <Variable name="b伸出命令" orderWithinParamSet="2">
                <Type>
                  <TypeName>BOOL</TypeName>
                </Type>
              </Variable>
              <Variable name="b缩回命令" orderWithinParamSet="3">
