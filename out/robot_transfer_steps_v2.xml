              <ST>    // 输出（b使能=FALSE 时保持输出）
    IF b使能 THEN
        b夹紧输出 := b夹紧命令;
    END_IF;

    // 超时监视
    t夹紧超时(IN := b使能 AND b夹紧命令 AND NOT x夹紧到位, PT := t超时);
    t松开超时(IN := b使能 AND NOT b夹紧命令 AND NOT x松开到位, PT := t超时);

    b报警 := FALSE;
    IF t夹紧超时.Q THEN
        b报警 := TRUE;
        n报警码 := n夹紧报警码;
    ELSIF t松开超时.Q THEN
        b报警 := TRUE;
        n报警码 := n松开报警码;
    END_IF;</ST>
