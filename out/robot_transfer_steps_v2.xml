          </Parameters>
          <Vars accessSpecifier="private">
            <Variable name="t伸出超时">
              <Type>
                <TypeName>TON</TypeName>
              </Type>
            </Variable>
            <Variable name="t缩回超时">
              <Type>
                <TypeName>TON</TypeName>
              </Type>
            </Variable>
          </Vars>
          <MainBody>
            <BodyContent xsi:type="ST">
              <ST>    // 输出（b使能=FALSE 时保持输出，配合报警/急停冻结）
    IF b使能 THEN
        b伸出输出 := b伸出命令;
        b缩回输出 := b缩回命令;
    END_IF;

    // 超时监视
    t伸出超时(IN := b使能 AND b伸出命令 AND NOT x伸出到位, PT := t超时);
    t缩回超时(IN := b使能 AND b缩回命令 AND NOT x原位到位, PT := t超时);

    b报警 := FALSE;
    IF t伸出超时.Q THEN
        b报警 := TRUE;
        n报警码 := n伸出报警码;
    ELSIF t缩回超时.Q THEN
        b报警 := TRUE;
        n报警码 := n缩回报警码;
    END_IF;</ST>
            </BodyContent>
          </MainBody>
        </FunctionBlock>
