              <TypeName>INT</TypeName>
            </Type>
          </Variable>
          <Variable name="nSet">
            <Type>
              <TypeName>INT</TypeName>
            </Type>
            <InitialValue>
              <SimpleValue value="600"/>
            </InitialValue>
          </Variable>
          <Variable name="nHyst">
            <Type>
              <TypeName>INT</TypeName>
            </Type>
            <InitialValue>
              <SimpleValue value="20"/>
            </InitialValue>
          </Variable>
          <Variable name="nTempMin">
            <Type>
              <TypeName>INT</TypeName>
            </Type>
            <InitialValue>
              <SimpleValue value="-500"/>
            </InitialValue>
          </Variable>
          <Variable name="nTempMax">
            <Type>
              <TypeName>INT</TypeName>
            </Type>
            <InitialValue>
              <SimpleValue value="1500"/>
            </InitialValue>
          </Variable>
          <Variable name="bRun">
            <Type>
              <TypeName>BOOL</TypeName>
            </Type>
            <InitialValue>
              <SimpleValue value="FALSE"/>
            </InitialValue>
          </Variable>
          <Variable name="bErr">
            <Type>
              <TypeName>BOOL</TypeName>
            </Type>
            <InitialValue>
              <SimpleValue value="FALSE"/>
            </InitialValue>
          </Variable>
          <Variable name="bHeat">
            <Type>
              <TypeName>BOOL</TypeName>
            </Type>
            <InitialValue>
              <SimpleValue value="FALSE"/>
            </InitialValue>
          </Variable>
          <Variable name="bCool">
            <Type>
              <TypeName>BOOL</TypeName>
            </Type>
            <InitialValue>
              <SimpleValue value="FALSE"/>
            </InitialValue>
          </Variable>
          <Variable name="nBits">
            <Type>
              <TypeName>INT</TypeName>
            </Type>
            <InitialValue>
              <SimpleValue value="0"/>
            </InitialValue>
          </Variable>
          <Variable name="bChecked">
            <Type>
              <TypeName>BOOL</TypeName>
            </Type>
            <InitialValue>
              <SimpleValue value="FALSE"/>
            </InitialValue>
          </Variable>
        </Vars>
        <MainBody>
          <BodyContent xsi:type="ST">
            <ST>    // ---- 1) 每秒推进阶段，并记录上一阶段结束时的 Y0/Y1 ----
    tTick(IN := NOT tTick.Q, PT := T#1s);
    IF tTick.Q THEN
        nBits := 0;
        IF Y0 THEN
            nBits := nBits + 1;
        END_IF;
        IF Y1 THEN
            nBits := nBits + 2;
        END_IF;

        CASE nPhase OF
            0: D310 := nBits;
            1: D311 := nBits;
            2: D312 := nBits;
            3: D313 := nBits;
            4: D314 := nBits;
            5: D315 := nBits;
            6: D316 := nBits;
        END_CASE;

        nPhase := nPhase + 1;

        // 7 个阶段结束后自检（0=PASS，1=FAIL）
        IF nPhase = 7 AND NOT bChecked THEN
            bChecked := TRUE;
            IF D310 = 0 AND D311 = 1 AND D312 = 0 AND D313 = 2
               AND D314 = 0 AND D315 = 0 AND D316 = 1 THEN
                D320 := 0;
            ELSE
                D320 := 1;
            END_IF;
        END_IF;
    END_IF;

    // ---- 2) 各阶段设定温度 D100 ----
    CASE nPhase OF
        0: D100 := 0;      // 冷态、未启动
        1: D100 := 0;      // 启动 → 加热
        2: D100 := 600;    // 到设定 → 停加热
        3: D100 := 620;    // 到设定+回差 → 冷却
        4: D100 := 600;    // 回设定 → 停冷却
        5: D100 := 2000;   // 超量程 → 故障停输出
        6: D100 := 0;      // 回到量程、重新启动 → 加热
        ELSE
            D100 := 0;
    END_CASE;

    // ---- 3) 与模板一致的控制逻辑（故障非锁存） ----
    nTemp := D100;
    bErr := FALSE;
    IF nTemp &lt;= nTempMin OR nTemp &gt;= nTempMax THEN
        bErr := TRUE;
        bRun := FALSE;
    END_IF;

    // 阶段 1..4 正常运行；阶段 6 模拟 X0 重新启动
    IF nPhase &gt;= 1 AND nPhase &lt;= 4 THEN
        bRun := TRUE;
    END_IF;
    IF nPhase = 6 THEN
        bRun := TRUE;
    END_IF;

    IF bRun AND NOT bErr THEN
        IF nTemp &lt;= nSet - nHyst THEN
            bHeat := TRUE;
        END_IF;
        IF nTemp &gt;= nSet THEN
            bHeat := FALSE;
        END_IF;
        IF nTemp &gt;= nSet + nHyst THEN
            bCool := TRUE;
        END_IF;
        IF nTemp &lt;= nSet THEN
            bCool := FALSE;
        END_IF;
    ELSE
        bHeat := FALSE;
        bCool := FALSE;
    END_IF;

    // ---- 4) 输出 ----
    Y0 := bRun AND bHeat;
    Y1 := bRun AND bCool;</ST>
          </BodyContent>
        </MainBody>
      </Program>
    </GlobalNamespace>
