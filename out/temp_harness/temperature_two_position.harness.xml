  <ContentHeader name="temperature_two_position.harness" creationDateTime="2026-11-11T05:26:10.154Z" modificationDateTime="2026-11-11T05:26:10.154Z"/>
  <Types>
    <GlobalNamespace>
      <Program name="Main">
        <Vars accessSpecifier="private">
          <Variable name="nPhase">
            <Type>
              <TypeName>INT</TypeName>
            </Type>
            <InitialValue>
              <SimpleValue value="0"/>
            </InitialValue>
          </Variable>
