{
  "name": "ai-st-gxworks3",
  "version": "0.8.0",
  "private": true,
  "description": "AI 驱动的三菱 GX Works3 ST 语言代码生成与校验工具（FX5U / iQ-F）",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "bin": {
    "ai-st-gxworks3": "./src/cli.ts"
  },
  "scripts": {
    "start": "node --experimental-strip-types --no-warnings src/cli.ts",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "check": "node --experimental-strip-types --no-warnings src/cli.ts check",
    "deliver": "node --experimental-strip-types --no-warnings src/cli.ts deliver",
    "mcp": "node --experimental-strip-types --no-warnings src/cli.ts mcp",
    "build-xml": "node --experimental-strip-types --no-warnings src/cli.ts build-xml"
  },
  "keywords": [
    "PLC",
    "mitsubishi",
    "gxworks3",
    "structured-text",
    "IEC-61131-3",
    "AI",
    "codegen"
  ],
  "license": "MIT"
}
